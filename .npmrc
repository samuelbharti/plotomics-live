# plotomics declares react/react-dom as optional peers (only its own example
# wrappers touch React; the factories this app calls take a plain DOM element)
# pinned to ^18, while this app runs React 19. Nothing here actually imports
# React from plotomics, so the mismatch is cosmetic: skip strict peer
# resolution rather than let npm hard-fail on it.
legacy-peer-deps=true
